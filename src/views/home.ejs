<%- include('partials/head', { title: 'Find your next vehicle' }) %>
<%- include('partials/header') %>
<% const featuredImageFallbacks = [
  'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=900&q=82',
  'https://images.unsplash.com/photo-1551830820-330a71b99659?auto=format&fit=crop&w=900&q=82',
  'https://images.unsplash.com/photo-1617469767053-d3b523a0b982?auto=format&fit=crop&w=900&q=82'
]; %>
<main class="home-main">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-panel">
      <img class="hero-image" src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=2200&q=88" alt="A modern car ready for a drive" fetchpriority="high">
      <div class="hero-content">
        <p class="eyebrow">Good cars. Good people.</p>
        <h1 id="hero-title">Find your next <span>great drive.</span></h1>
        <p class="hero-copy">Thoughtfully chosen, thoroughly checked, and priced with nothing to hide. Your next chapter starts right here.</p>
        <div class="hero-ctas"><a class="button" href="/vehicles">Explore our cars <span aria-hidden="true">→</span></a><a class="button button-light" href="#how-it-works">How we make it easy</a></div>
        <div class="hero-note"><strong>Carefully selected</strong><span>·</span><span>Ready for the road ahead</span></div>
      </div>
    </div>
    <form class="search-card" action="/vehicles" method="get">
      <div class="search-top"><h2>Find a car that feels like you</h2><span>Browse our current inventory</span></div>
      <div class="filters">
        <div class="filter"><label for="category">Vehicle type</label><select id="category" name="category"><option value="">Any type</option><% if (categories) { categories.forEach((category) => { %><option value="<%= category.slug %>"><%= category.name %></option><% }) } %></select></div>
        <div class="filter"><label for="sort">Sort inventory</label><select id="sort" name="sort"><option value="newest">Recently added</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option></select></div>
        <button class="search-submit" type="submit">Search cars <span aria-hidden="true">→</span></button>
      </div>
    </form>
  </section>

  <section class="section wrap" aria-labelledby="featured-heading">
    <div class="section-head"><div><div class="section-kicker">Picked for the road ahead</div><h2 id="featured-heading">A few good ones</h2><p class="section-sub">Every car has a story. These are ready for their next one.</p></div><a class="text-link" href="/vehicles">See all inventory <span aria-hidden="true">→</span></a></div>
    <% if (featuredVehicles && featuredVehicles.length) { %>
      <div class="vehicle-grid">
        <% featuredVehicles.forEach((vehicle, index) => { %>
          <article class="vehicle-card">
            <img src="<%= vehicle.image_url || featuredImageFallbacks[index % featuredImageFallbacks.length] %>" alt="<%= vehicle.image_alt || `${vehicle.model_year} ${vehicle.make} ${vehicle.model}` %>" loading="lazy">
            <div class="vehicle-card-body">
              <p class="eyebrow"><%= vehicle.category_name || 'Carefully selected' %></p>
              <h3><a href="/vehicles/<%= vehicle.id %>"><%= vehicle.model_year %> <%= vehicle.make %> <%= vehicle.model %></a></h3>
              <p class="price"><%= Number(vehicle.price).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %></p>
              <p class="vehicle-meta"><%= vehicle.mileage.toLocaleString() %> miles · <%= vehicle.transmission || 'Details available' %></p>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p>No featured vehicles are available right now. <a class="text-link" href="/vehicles">Browse all inventory →</a></p>
    <% } %>
  </section>
  <section class="why wrap" id="why-us" aria-labelledby="why-title"><div class="why-panel"><div class="why-copy"><div class="section-kicker">The Northstar difference</div><h2 id="why-title">Buying a car can feel this good.</h2><p>No mystery fees, no pressure, no surprises later. Just a team that knows cars and cares about finding the right one for you.</p><div class="why-points"><div class="why-point"><span class="check">✓</span>Carefully inspected</div><div class="why-point"><span class="check">✓</span>Clear, honest pricing</div><div class="why-point"><span class="check">✓</span>Support from real people</div><div class="why-point"><span class="check">✓</span>Here for the long run</div></div></div><div class="why-image"><img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1200&q=85" alt="A well-kept sports car ready for a scenic drive" loading="lazy"><div class="rating"><strong>Northstar Motors</strong><small>Good cars. Good people.</small></div></div></div></section>
  <section class="steps wrap" id="how-it-works" aria-labelledby="steps-title"><div class="section-head"><div><div class="section-kicker">Easy as a Sunday drive</div><h2 id="steps-title">Your car, your way.</h2></div><a class="text-link" href="/contact">Questions? Talk to us <span aria-hidden="true">→</span></a></div><div class="step-grid"><article class="step"><span class="step-no">01 / EXPLORE</span><h3>Find the one</h3><p>Browse our handpicked inventory online or drop by for a look around.</p></article><article class="step"><span class="step-no">02 / TAKE A SPIN</span><h3>Make it yours</h3><p>Take your favorite out for a drive. We’ll get you the keys, no pressure.</p></article><article class="step"><span class="step-no">03 / HIT THE ROAD</span><h3>We’ll handle the rest</h3><p>Simple paperwork and straightforward help from our team.</p></article></div></section>
  <section class="cta wrap" id="contact"><div><h2>Ready when you are.</h2><p>Your next great drive is closer than you think.</p></div><a class="button" href="/contact">Let’s find your car <span aria-hidden="true">→</span></a></section>
</main>
<%- include('partials/footer') %>
